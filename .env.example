# ============ BondhuMeter environment template ============
# Copy this file to ".env" for local development, or paste the
# values into Vercel: Project → Settings → Environment Variables.

# ---------- DATABASE (required) ----------
# PRODUCTION (Vercel): create a free Postgres at https://neon.tech
#   and paste the connection string they give you:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# LOCAL development: SQLite file (no setup needed)
DATABASE_URL="file:../db/custom.db"

# ---------- SECURITY (required) ----------
# Secret used to sign login session cookies. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-a-long-random-hex-string

# ---------- ADMIN ----------
# Password for the Admin Control Room (website → footer → Admin)
ADMIN_PASSWORD=change-this-password

# ---------- GOOGLE LOGIN (optional) ----------
# Leave empty to hide the Google button. Full guide: GOOGLE_SETUP.md
# After deploying, add this redirect URI in Google Cloud Console:
#   https://your-domain/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
